#!/bin/bash
#reset
kubectl delete namespace blue green
#lab2 changes
kubectl create namespace blue
kubectl create namespace green
#lab3 changes
kubectl create configmap settings --from-literal=colour=blue --namespace blue
kubectl create configmap settings --from-literal=colour=green --namespace green
kubectl create secret generic secrets --from-literal password=MySecretPhrase --namespace green
kubectl create secret generic secrets --from-literal password=ReallySecret --namespace blue
#lab4 changes
#create fe and be in prod and dev
kubectl create deploy backend --image=public.ecr.aws/qa-wfl/qa-wfl/qakf/sbe:v1 -n blue
kubectl create deploy backend --image=public.ecr.aws/qa-wfl/qa-wfl/qakf/sbe:v2 -n green
kubectl expose deployment backend --port 80 --target-port 8080 --name backend --namespace blue
kubectl expose deployment backend --port 80 --target-port 8080 --name backend -n green
kubectl create -f ../solutions/04_01_lab4frontend.yaml -n blue
kubectl create -f ../solutions/04_01_lab4frontend.yaml -n green
kubectl expose deployment frontend --port 80 --target-port 8080 --name frontend --namespace blue
kubectl expose deployment frontend --port 80 --target-port 8080 --name frontend -n green
kubectl create service externalname frontend --external-name frontend.green.svc.cluster.local
helm install ingress-nginx ingress-nginx \
  --repo https://kubernetes.github.io/ingress-nginx \
  --set controller.service.type=NodePort \
  --namespace ingress-nginx --create-namespace
sleep 30
